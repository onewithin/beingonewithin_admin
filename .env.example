# Base URL of the Prana backend API.
# Exposed to the browser (NEXT_PUBLIC_ prefix) — do not put secrets here.
# Defaults to http://localhost:3010/api when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010/api

# Secret used by NextAuth to sign/encrypt JWTs and cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL of this admin app. Required in production deployments.
NEXTAUTH_URL=http://localhost:3000
